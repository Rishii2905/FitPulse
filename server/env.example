# Copy this file to ".env" and fill in your own values.
# .env is where secrets/config live OUTSIDE the code, so we never hardcode them.

# Which port the Express server listens on
PORT=5000

# Your MongoDB connection string (from MongoDB Atlas, or "mongodb://localhost:27017/fitpulse" if running Mongo locally)
MONGO_URI=your_mongodb_connection_string_here

# A long random string used to sign login tokens (JWT). Any long random text works.
JWT_SECRET=replace_this_with_a_long_random_string
